---
import Section from "@/components/Section.astro";
import { field, srcset } from "@/data/photos";
---

<Section id="field">
  <div class="flex items-baseline justify-between gap-4">
    <h2 class="section-title">From the field</h2>
    <a class="textlink" href="/photography">All photos</a>
  </div>

  <div class="arrive grid grid-cols-2 gap-4 min-[860px]:grid-cols-4">
    {
      field.map((photo, i) => (
        <figure style={`--i:${i}`}>
          <a class="lean block overflow-hidden" href={`/photography/photo/${photo.id}`}>
            <img
              class="bg-card block aspect-[3/2] w-full object-cover"
              src={photo.files.card}
              srcset={srcset(photo)}
              sizes="(max-width: 860px) 50vw, 280px"
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
            />
          </a>
          <figcaption class="pt-2.5 text-[15px]">{photo.title}</figcaption>
        </figure>
      ))
    }
  </div>
</Section>
