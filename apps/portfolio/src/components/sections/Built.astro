---
import Section from "@/components/Section.astro";
import { birdup } from "@/data/birdup";
---

<Section id="built" title="How BirdUp is built">
  <p class="data">{birdup.stack.join(" · ")}</p>
  <div class="mt-7 grid gap-[clamp(20px,3vw,48px)] min-[860px]:grid-cols-3">
    {
      birdup.notes.map((note) => (
        <div>
          <h3 class="font-medium">{note.title}</h3>
          <p class="text-muted-foreground mt-1 text-[17px]">{note.body}</p>
        </div>
      ))
    }
  </div>
</Section>
