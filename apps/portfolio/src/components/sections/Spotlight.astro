---
import { Badge } from "@goodpie/ui/components/badge";
import FadeIn from "@/components/animations/FadeIn";
import ExternalLinkIcon from "@/components/icons/ExternalLinkIcon.astro";
import Section from "@/components/Section.astro";
import { birdup } from "@/data/birdup";
---

<Section>
  <FadeIn client:visible direction="up">
    <div class="border-border bg-card relative overflow-hidden rounded-2xl border p-8 md:p-12">
      {/* Signature: an ambient teal glow that lifts this panel off the flat numbered sections */}
      <div
        aria-hidden="true"
        class="bg-teal/20 pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full blur-3xl"
      >
      </div>

      <div class="relative">
        {/* Off-sequence marker — deliberately a diamond, not a 01/02/03 number */}
        <div class="mb-6 flex items-center gap-3">
          <span class="bg-teal inline-block size-2 rotate-45"></span>
          <span class="text-muted-foreground text-xs font-medium tracking-widest uppercase">
            {birdup.eyebrow}
          </span>
        </div>

        <h2 class="font-serif text-5xl tracking-tight md:text-6xl">
          {birdup.name}<span class="text-teal">.</span>
        </h2>

        <p class="text-muted-foreground mt-4 max-w-2xl font-serif text-xl italic md:text-2xl">
          {birdup.tagline}
        </p>

        <p class="text-muted-foreground mt-6 max-w-2xl leading-relaxed">
          {birdup.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={birdup.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit the ${birdup.name} website`}
            class="bg-teal text-background hover:bg-teal/90 inline-flex h-11 items-center gap-2 rounded-md px-6 text-sm font-medium transition-colors"
          >
            {birdup.cta}
            <ExternalLinkIcon size={16} />
          </a>

          <div class="flex flex-wrap gap-2">
            {
              birdup.stack.map((tech) => (
                <Badge variant="outline" className="font-mono text-xs font-normal">
                  {tech}
                </Badge>
              ))
            }
          </div>
        </div>

        <div class="border-border mt-10 grid gap-8 border-t pt-10 md:grid-cols-3">
          {
            birdup.highlights.map((highlight) => (
              <div>
                <div class="bg-teal mb-3 h-px w-8" />
                <h3 class="text-foreground font-medium">{highlight.title}</h3>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {highlight.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </FadeIn>
</Section>
