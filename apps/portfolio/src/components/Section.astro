---
interface Props {
  id?: string;
  title?: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<section id={id} class:list={["border-border border-t py-[clamp(40px,6vw,72px)]", className]}>
  {title && <h2 class="section-title">{title}</h2>}
  <slot />
</section>
