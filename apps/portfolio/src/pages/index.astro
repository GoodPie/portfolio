---
import Section from "@/components/Section.astro";
import BirdUp from "@/components/sections/BirdUp.astro";
import Built from "@/components/sections/Built.astro";
import Field from "@/components/sections/Field.astro";
import Opening from "@/components/sections/Opening.astro";
import OpenSource from "@/components/sections/OpenSource.astro";
import Work from "@/components/sections/Work.astro";
import Writing from "@/components/sections/Writing.astro";
import StructuredData from "@/components/StructuredData.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { personSchema } from "@/lib/schema";

const nav = [
  { label: "BirdUp", href: "#birdup" },
  { label: "Photos", href: "/photography" },
  { label: "Writing", href: "/blog" },
  { label: "GitHub", href: "https://github.com/Goodpie" },
  { label: "Email", href: "mailto:contact@brandynbritton.com" },
];
---

<BaseLayout>
  <StructuredData slot="head" schema={personSchema()} />

  <header
    slot="header"
    class="border-border flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b py-7"
  >
    <h1 class="text-[17px] font-medium">Brandyn Britton</h1>
    <nav aria-label="Main" class="flex flex-wrap gap-x-7 gap-y-1 text-[17px]">
      {
        nav.map((item) => (
          <a class="decoration-1 underline-offset-[0.18em] hover:underline" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </header>

  <Opening />
  <BirdUp />
  <Field />
  <Built />
  <Section class="grid gap-[clamp(28px,5vw,72px)] min-[860px]:grid-cols-[7fr_5fr]">
    <Writing />
    <OpenSource />
  </Section>
  <Work />

  <footer
    slot="footer"
    class="border-border flex flex-wrap gap-x-7 gap-y-1 border-t pt-7 text-[17px]"
  >
    <a class="textlink" href="mailto:contact@brandynbritton.com">contact@brandynbritton.com</a>
    <a class="textlink" href="https://github.com/Goodpie">GitHub</a>
    <a class="textlink" href="https://linkedin.com/in/brandyn-britton">LinkedIn</a>
  </footer>
</BaseLayout>
